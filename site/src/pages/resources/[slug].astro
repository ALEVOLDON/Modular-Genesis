---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Icon from "../../components/Icon.astro";
import { withBase } from "../../lib/paths";

export async function getStaticPaths() {
  const notes = await getCollection("notes");

  return notes.map((note) => ({
    params: { slug: note.slug },
    props: { note }
  }));
}

const { note } = Astro.props;
const { Content } = await render(note);
const otherNotes = (await getCollection("notes"))
  .filter((entry) => entry.slug !== note.slug)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);
---

<BaseLayout
  title={`${note.data.title} | Modular Genesis`}
  description={note.data.summary}
  localeSwitch={{ href: `/ru/resources/${note.slug}/`, label: "RU" }}
>
  <div class="page-stack">
    <section class="band band-hero">
      <div class="band-shell">
        <div class="display-grid">
          <div>
            <div class="eyebrow"><Icon name="notebook-pen" /> Reference Note</div>
            <h1 class="display-title" style="max-width: 8ch; font-size: clamp(3.1rem, 7vw, 5.4rem);">
              {note.data.title}
            </h1>
            <p class="lede">{note.data.summary}</p>
            <div class="actions">
              <a class="button" href={withBase("/resources")}><Icon name="notebook-pen" /> <span>Back to resources</span></a>
              <a class="button-secondary" href={withBase("/roadmap")}><Icon name="map" /> <span>Open roadmap</span></a>
            </div>
          </div>

          <div class="hero-dashboard">
            <article class="feature-card">
              <span class="section-label"><Icon name="library-big" /> Reference role</span>
              <h3>Concept layer for the public system</h3>
              <p>
                Notes like this exist to explain the stable logic behind lessons, patch references,
                and future site growth.
              </p>
              <ul class="feature-list">
                <li>workflow and routing context</li>
                <li>system architecture and project direction</li>
                <li>support material for future lessons and artifacts</li>
              </ul>
            </article>
          </div>
        </div>
      </div>
    </section>

    <section class="band band-subtle">
      <div class="band-shell">
        <article class="feature-card prose-panel">
          <Content />
        </article>
      </div>
    </section>

    <section class="band band-deep">
      <div class="band-shell">
        <div class="stack-grid">
          <article class="feature-card">
            <span class="card-kicker"><Icon name="files" /> More notes</span>
            <h3>Related references</h3>
            <ul class="feature-list">
              {otherNotes.map((entry) => (
                <li>
                  <a class="related-link" href={withBase(`/resources/${entry.slug}/`)}>
                    <Icon name="move-right" />
                    <span>{entry.data.title}</span>
                  </a>
                </li>
              ))}
            </ul>
          </article>

          <article class="feature-card">
            <span class="card-kicker"><Icon name="move-right" /> Navigation</span>
            <h3>Continue through the system</h3>
            <p>Reference material is meant to feed back into the roadmap, lessons, and patch library.</p>
            <div class="actions">
              <a class="button-secondary" href={withBase("/course")}><Icon name="book-open" /> <span>Open course</span></a>
              <a class="button-secondary" href={withBase("/patches")}><Icon name="panels-top-left" /> <span>Open patches</span></a>
            </div>
          </article>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
