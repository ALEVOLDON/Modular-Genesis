---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Icon from "../../components/Icon.astro";
import { getCollection } from "astro:content";
import { tracks } from "../../data/tracks";
import { withBase } from "../../lib/paths";

const lessons = (await getCollection("ru-lessons")).sort((a, b) => {
  if (a.data.track === b.data.track) return a.data.order - b.data.order;
  return a.data.track.localeCompare(b.data.track);
});

const notes = (await getCollection("ru-notes")).sort((a, b) => a.data.order - b.data.order);
const patches = (await getCollection("ru-patches")).sort((a, b) => a.data.order - b.data.order);

const featuredLessons = lessons.slice(0, 3);
const featuredNotes = notes.slice(0, 3);
const featuredPatches = patches.slice(0, 3);

const heroSignals = [
  "Открытый план и каркас курса",
  "Библиотека патчей готова под реальные файлы",
  "Русская и английская версии онлайн"
];

const toolCards = [
  {
    icon: "audio-lines",
    title: "VCV Rack",
    text: "Главная модульная среда для синтеза, секвенсинга, вероятности и работы с сигналом."
  },
  {
    icon: "radio",
    title: "Ableton Live",
    text: "Аранжировка, маршрутизация, запись, performance-контроль и опорный слой гибридного workflow."
  },
  {
    icon: "sparkles",
    title: "Visual Layer",
    text: "Three.js, Blender и будущие real-time visual systems, связанные с поведением звука."
  },
  {
    icon: "folders",
    title: "Repository",
    text: "Документация, патчи, диаграммы и уроки, собранные как единая открытая система знаний."
  }
] as const;
---

<BaseLayout
  title="Modular Genesis | Русская версия"
  description="Русскоязычная стартовая страница проекта Modular Genesis."
  lang="ru"
  localeSwitch={{ href: "/", label: "EN" }}
>
  <div class="page-stack">
    <section class="band band-hero">
      <div class="band-shell">
        <div style="position: relative; padding: clamp(16px, 4vw, 48px); border-radius: clamp(16px, 4vw, 32px); border: 1px solid rgba(255, 255, 255, 0.05); overflow: hidden; box-shadow: var(--shadow); box-sizing: border-box;">
          <div class="bg-breathe" style={`position: absolute; inset: 0; background-image: url(${withBase("/images/hero_modular_cables.png")}); background-size: cover; background-position: center; background-repeat: no-repeat; z-index: 0;`}></div>
          <div style="position: absolute; inset: 0; background: linear-gradient(180deg, rgba(6,13,20,0.5) 0%, rgba(4,10,16,0.95) 100%); z-index: 1;"></div>
          <div class="display-grid" style="position: relative; z-index: 2;">
          <div>
            <div class="eyebrow"><Icon name="sparkles" /> Русская версия v0.1</div>
            <h1 class="display-title">
              Открытая <span class="accent">generative</span> система для modular sound и audiovisual practice.
            </h1>
            <p class="lede">
              Modular Genesis - это documentation-first проект про `VCV Rack`, `Ableton Live`,
              generative patch design, hybrid routing и audiovisual-структуру. Цель - собрать не разрозненные
              туториалы, а связную публичную систему.
            </p>
            <div class="actions">
              <a class="button" href={withBase("/ru/roadmap")}><Icon name="map" /> <span>Открыть план</span></a>
              <a class="button-secondary" href={withBase("/ru/course")}><Icon name="book-open" /> <span>Смотреть уроки</span></a>
              <a class="button-secondary" href={withBase("/ru/resources")}><Icon name="notebook-pen" /> <span>Читать материалы</span></a>
            </div>
            <div class="track-nav">
              {heroSignals.map((signal) => (
                <span class="track-chip"><Icon name="sparkles" /> <span>{signal}</span></span>
              ))}
            </div>
          </div>

          <div class="hero-dashboard">
            <article class="feature-card">
              <span class="section-label"><Icon name="workflow" /> Основной контур</span>
              <h3>VCV Rack + Ableton Live + Visuals</h3>
              <p>
                Сигнал, маршрутизация, секвенсинг и визуальный отклик понимаются как одна живая среда,
                а не как три отдельных процесса.
              </p>
              <ul class="feature-list">
                <li><strong>VCV Rack:</strong> generative engine и signal lab</li>
                <li><strong>Ableton Live:</strong> capture, routing и live host</li>
                <li><strong>Visuals:</strong> реактивная графика и будущий 3D-слой</li>
              </ul>
            </article>

            <div class="hero-dashboard-grid">
              <article class="mini-card">
                <span class="mini-stat">{tracks.length}</span>
                <h4><Icon name="audio-lines" /> Структурированных трека</h4>
                <p>От vocabularies напряжения до performance и audiovisual-систем.</p>
              </article>
              <article class="mini-card">
                <span class="mini-stat">{lessons.length}</span>
                <h4><Icon name="book-open" /> Опубликованных уроков</h4>
                <p>Базовые, генеративные и гибридные темы уже доступны для изучения.</p>
              </article>
              <article class="mini-card">
                <span class="mini-stat">{notes.length}</span>
                <h4><Icon name="notebook-pen" /> Опорных заметок</h4>
                <p>Архитектурные и концептуальные тексты, держащие систему вместе.</p>
              </article>
              <article class="mini-card">
                <span class="mini-stat">{patches.length}</span>
                <h4><Icon name="panels-top-left" /> Карточек патчей</h4>
                <p>Каталог подготовлен под реальные `.vcv` файлы и аудио-примеры.</p>
              </article>
            </div>
          </div>
        </div>
        </div>
      </div>
    </section>

    <section class="band band-deep">
      <div class="band-shell">
        <div class="split-hero">
          <article class="feature-card">
            <span class="section-label"><Icon name="square-chart-gantt" /> Текущий фокус</span>
            <h2>Каркас уже собран. Следующий шаг - наполнение реальными артефактами.</h2>
            <p>
              Сейчас проект находится в состоянии v0.1: сайт, роутинг, документация и архитектура готовы.
              Дальше репозиторий наполняется `.vcv` файлами, аудиодемо и визуальными моделями.
            </p>
            <ul class="feature-list">
              <li><strong><Icon name="map" /> План:</strong> поэтапный переход от signal flow к audiovisual системам.</li>
              <li><strong><Icon name="book-open" /> Уроки:</strong> пошаговый разбор patch logic и hybrid workflows.</li>
              <li><strong><Icon name="panels-top-left" /> Библиотека патчей:</strong> практические шаблоны под VCV Rack.</li>
            </ul>
          </article>

          <div class="terminal-window">
            <div class="terminal-header">
              <span class="terminal-dot red"></span>
              <span class="terminal-dot yellow"></span>
              <span class="terminal-dot green"></span>
              <span class="terminal-title">genesis-system-manifest.json</span>
            </div>
            <div class="terminal-body">
              <pre><code>&#123;
  "project": "Modular Genesis",
  "status": "Public Draft v0.1",
  "stack": ["VCV Rack", "Ableton Live", "Astro", "Three.js"],
  "tracks": [
    "01_foundations",
    "02_sequencing",
    "03_generative",
    "04_hybrid",
    "05_audiovisual"
  ],
  "engine_state": "Operational",
  "routing": "Bi-directional Multi-track"
&#125;</code></pre>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="band band-subtle">
      <div class="band-shell">
        <div class="section-copy">
          <span class="section-label"><Icon name="boxes" /> Экосистема</span>
          <h2>Инструменты разделены по ролям, но работают как один организм.</h2>
          <p>
            Проект не делит synthesis, arrangement и visuals на отдельные дисциплины.
            Он собирает их как связанные слои одной системы.
          </p>
        </div>
        <div class="stack-grid-4" style="margin-top: 26px;">
          {toolCards.map((tool) => (
            <article class="feature-card">
              <span class="card-kicker"><Icon name={tool.icon} /> Инструмент</span>
              <h3>{tool.title}</h3>
              <p>{tool.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="band band-alt">
      <div class="band-shell">
        <div style="position: relative; padding: clamp(16px, 4vw, 48px); border-radius: clamp(16px, 4vw, 32px); border: 1px solid rgba(255, 255, 255, 0.05); overflow: hidden; box-shadow: var(--shadow); box-sizing: border-box;">
          <div class="bg-breathe" style={`position: absolute; inset: 0; background-image: url(${withBase("/images/generative_abstract_mesh.png")}); background-size: cover; background-position: center; background-repeat: no-repeat; z-index: 0;`}></div>
          <div style="position: absolute; inset: 0; background: linear-gradient(90deg, rgba(4,10,16,0.95) 0%, rgba(6,13,20,0.4) 100%); z-index: 1;"></div>
          <div class="split-hero" style="position: relative; z-index: 2;">
            <div class="feature-card" style="background: rgba(3, 9, 15, 0.65); backdrop-filter: blur(12px); border-color: rgba(255, 255, 255, 0.08);">
            <span class="section-label"><Icon name="sparkles" /> Почему modular</span>
            <h2>Это не просто sound design workflow, а среда для исследования.</h2>
            <p>
              Модульные системы соединяют композицию, логику, импровизацию и инженерию.
              Поэтому они подходят для живых систем, а не только для статичных пресетов.
            </p>
            <ul class="feature-list">
              <li><strong>Routing как композиция:</strong> сам signal path становится частью формы.</li>
              <li><strong>Generative logic:</strong> clocks, probability, mutation и feedback создают evolving behavior.</li>
              <li><strong>Audiovisual expansion:</strong> звуковые события позже могут управлять geometry, motion и scenes.</li>
            </ul>
          </div>

            <div>
              <!-- Пустая колонка для отображения фона сетки -->
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="band band-subtle">
      <div class="band-shell">
        <div class="section-copy">
          <span class="section-label"><Icon name="library-big" /> Архитектура</span>
          <h2>Три устойчивых слоя уже собраны.</h2>
          <p>
            Текущая публичная версия - это еще не завершенный контент, а стабильный проектный каркас:
            архитектура системы, архитектура обучения и архитектура репозитория.
          </p>
        </div>
        <div class="timeline-summary" style="margin-top: 26px;">
          <article class="feature-card blueprint-card">
            <div>
              <span class="card-kicker"><Icon name="files" /> Каркас</span>
              <h3>Сайт уже разделен на стабильные функциональные слои.</h3>
              <p>
                Текущая версия эффективнее всего читается как инфраструктура: один слой объясняет систему,
                второй обучает рабочему процессу, а третий хранит библиотеку патчей для будущих реальных артефактов.
              </p>
              <ul class="feature-list">
                <li><strong>Системный слой:</strong> диаграммы, заметки и план задают структуру.</li>
                <li><strong>Слой обучения:</strong> уроки сгруппированы по трекам, а не разбросаны отдельными статьями.</li>
                <li><strong>Слой репозитория:</strong> карточки патчей уже привязаны к папкам и медиа-артефактам.</li>
              </ul>
            </div>

            <div class="blueprint-widget">
              <div class="widget-header">
                <span class="widget-title"><Icon name="cpu" /> Спецификации инфраструктуры</span>
                <span class="widget-badge">v0.2.0</span>
              </div>
              <div class="widget-grid">
                <div class="widget-item">
                  <span class="label">Движок</span>
                  <span class="value">VCV Rack + Ableton</span>
                </div>
                <div class="widget-item">
                  <span class="label">Генератив</span>
                  <span class="value">Probability & Markov</span>
                </div>
                <div class="widget-item">
                  <span class="label">Маршрутизация</span>
                  <span class="value">Multichannel CV/MIDI</span>
                </div>
                <div class="widget-item">
                  <span class="label">Визуал</span>
                  <span class="value">Audio-Reactive OSC</span>
                </div>
              </div>
              <div class="widget-action">
                <a class="button-secondary" href={withBase("/ru/roadmap")}><Icon name="map" /> <span>Изучить план системы</span></a>
              </div>
            </div>
          </article>
        </div>
      </div>
    </section>

    <section class="band band-deep">
      <div class="band-shell">
        <div class="section-head">
          <div class="section-copy">
            <span class="section-label"><Icon name="audio-lines" /> Живой контент</span>
            <h2>На сайте уже есть материал, а не просто пустой фасад.</h2>
            <p>Уроки, материалы и карточки патчей разведены по понятным колонкам, чтобы каждый слой читался отдельно.</p>
          </div>
          <a class="button-secondary" href={withBase("/ru/course")}>Все уроки</a>
        </div>

        <div class="roadmap-strip" style="margin: 26px 0 24px;">
          {tracks.map((track, index) => (
            <article class="roadmap-step">
              <span class="index">{index + 1}</span>
              <h3>{track.title}</h3>
              <p>{track.description}</p>
            </article>
          ))}
        </div>

        <div class="cards-3">
          <article class="feature-card">
            <span class="card-kicker">Последние уроки</span>
            <div class="card-stack">
              {featuredLessons.map((lesson) => (
                <article class="card">
                  <span class="card-kicker">{lesson.data.track}</span>
                  <h3>{lesson.data.title}</h3>
                  <p>{lesson.data.summary}</p>
                  <div class="actions">
                    <a class="button-secondary" href={withBase(`/ru/course/${lesson.slug}/`)}>Открыть урок</a>
                  </div>
                </article>
              ))}
            </div>
          </article>

          <article class="feature-card">
            <span class="card-kicker">Базовые заметки</span>
            <div class="card-stack">
              {featuredNotes.map((note) => (
                <article class="card">
                  <h3>{note.data.title}</h3>
                  <p>{note.data.summary}</p>
                  <div class="actions">
                    <a class="button-secondary" href={withBase(`/ru/resources/${note.slug}/`)}>Открыть материал</a>
                  </div>
                </article>
              ))}
            </div>
          </article>

          <article class="feature-card">
            <span class="card-kicker">Библиотека патчей</span>
            <div class="card-stack">
              {featuredPatches.map((patch) => (
                <article class="card">
                  <span class="card-kicker">{patch.data.track}</span>
                  <h3>{patch.data.title}</h3>
                  <p>{patch.data.summary}</p>
                  <div class="actions">
                    <a class="button-secondary" href={withBase(`/ru/patches/${patch.slug}/`)}>Открыть патч</a>
                  </div>
                </article>
              ))}
            </div>
          </article>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
