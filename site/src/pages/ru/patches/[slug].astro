---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Icon from "../../../components/Icon.astro";
import { withBase } from "../../../lib/paths";

export async function getStaticPaths() {
  const patches = await getCollection("ru-patches");

  return patches.map((patch) => ({
    params: { slug: patch.slug },
    props: { patch }
  }));
}

const { patch } = Astro.props;
const { Content } = await render(patch);
const displayTrack = patch.data.track === "performances" ? "hybrid" : patch.data.track;

const collectionCopy = {
  foundations: { title: "Foundations" },
  sequencing: { title: "Sequencing" },
  generative: { title: "Generative" },
  performances: { title: "Performances" },
  hybrid: { title: "Hybrid" }
};
const translatedTrackTitle = collectionCopy[displayTrack as keyof typeof collectionCopy]?.title || "Foundations";

const siblingPatches = (await getCollection("ru-patches"))
  .filter((entry) => entry.data.track === patch.data.track && entry.slug !== patch.slug)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);
---

<BaseLayout
  title={`${patch.data.title} | Modular Genesis`}
  description={patch.data.summary}
  lang="ru"
  localeSwitch={{ href: `/patches/${patch.slug}/`, label: "EN" }}
>
  <div class="page-stack">
    <section class="band band-hero">
      <div class="band-shell">
        <div class="display-grid">
          <div>
            <div class="eyebrow"><Icon name="panels-top-left" /> {translatedTrackTitle}</div>
            <h1 class="display-title" style="max-width: 8ch; font-size: clamp(3.1rem, 7vw, 5.6rem);">
              {patch.data.title}
            </h1>
            <p class="lede">{patch.data.summary}</p>
            <div class="actions">
              <a class="button" href={withBase("/ru/patches")}><Icon name="panels-top-left" /> <span>Назад к патчам</span></a>
              <a class="button-secondary" href={withBase("/ru/course")}><Icon name="book-open" /> <span>Открыть курс</span></a>
            </div>
          </div>

          <div class="hero-dashboard">
            <article class="feature-card">
              <span class="section-label"><Icon name="square-chart-gantt" /> Метаданные патча</span>
              <h3>{patch.data.filename}</h3>
              <ul class="metric-list">
                <li>
                  <strong>{patch.data.status}</strong>
                  текущий статус артефакта
                </li>
                <li>
                  <strong>{patch.data.track}</strong>
                  трек коллекции
                </li>
                <li>
                  <strong>{patch.data.order}</strong>
                  текущий порядок внутри библиотеки
                </li>
                <li>
                  <strong>{patch.data.version ?? "v0.1"}</strong>
                  версия патча
                </li>
              </ul>
            </article>

            <article class="feature-card">
              <span class="section-label"><Icon name="folders" /> Путь в репозитории</span>
              <h3>Расположение patch file</h3>
              <p>
                Связанный patch artifact лежит в репозитории и позже может быть заменен реальным `VCV Rack` patch
                без изменения site route.
              </p>
              <div class="code-block" style="display: flex; align-items: center; justify-content: space-between; gap: 10px; flex-wrap: wrap;">
                <code>{`patches/${patch.data.track}/${patch.data.filename}`}</code>
                <button type="button" class="copy-pill-btn" data-copy-btn data-copy-value={`patches/${patch.data.track}/${patch.data.filename}`}>
                  <Icon name="copy" />
                  <span>Скопировать путь</span>
                </button>
              </div>
              <div style="margin-top: 12px;">
                <a
                  class="button-secondary"
                  href={`https://github.com/ALEVOLDON/Modular-Genesis/blob/main/patches/${patch.data.track}/${patch.data.filename}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  style="width: 100%; justify-content: center;"
                >
                  <Icon name="git-fork" />
                  <span>Открыть .vcv на GitHub</span>
                </a>
              </div>
            </article>
          </div>
        </div>
      </div>
    </section>

    <section class="band band-alt">
      <div class="band-shell">
        <div class="stack-grid">
          <article class="feature-card">
            <span class="card-kicker"><Icon name="files" /> Состояние медиа</span>
            <h3>Подключенные материалы</h3>
            <ul class="feature-list">
              <li>
                <strong>Скриншот:</strong> {patch.data.image ? "подключен" : "еще не добавлен"}
              </li>
              <li>
                <strong>Демо-аудио:</strong> {patch.data.audio ? "подключено" : "еще не добавлено"}
              </li>
              <li>
                <strong>Длительность:</strong> {patch.data.duration ?? "не указана"}
              </li>
            </ul>
          </article>

          {patch.data.image ? (
            <div class="media-frame">
              <img src={withBase(patch.data.image)} alt={`${patch.data.title} screenshot`} />
            </div>
          ) : (
            <article class="feature-card">
              <span class="card-kicker"><Icon name="move-right" /> Следующий артефакт</span>
              <h3>Рекомендуемый первый файл</h3>
              <p>Добавь один clean patch screenshot в `assets/images/patches/` и подключи его к этому entry.</p>
            </article>
          )}

          {patch.data.audio ? (
            <article class="feature-card">
              <span class="card-kicker"><Icon name="audio-lines" /> Демо-аудио</span>
              <h3>Предпросмотр патча</h3>
              <audio controls preload="none" style="width: 100%; margin-top: 8px;">
                <source src={withBase(patch.data.audio)} />
              </audio>
            </article>
          ) : (
            <article class="feature-card">
              <span class="card-kicker"><Icon name="audio-lines" /> Аудиоцель</span>
              <h3>Рекомендуемое демо</h3>
              <p>Экспортируй короткий 20-60 second example и положи его в `assets/audio/patches/`.</p>
            </article>
          )}
        </div>
      </div>
    </section>

    <section class="band band-subtle">
      <div class="band-shell">
        <article class="feature-card prose-panel">
          <Content />
        </article>
      </div>
    </section>

    <section class="band band-deep">
      <div class="band-shell">
        <div class="stack-grid">
          <article class="feature-card">
            <span class="card-kicker">Та же коллекция</span>
            <h3>Другие patch entries</h3>
            <ul class="feature-list">
              {siblingPatches.map((entry) => (
                <li>
                  <a class="related-link" href={withBase(`/ru/patches/${entry.slug}/`)}>
                    <Icon name="move-right" />
                    <span>{entry.data.title}</span>
                  </a>
                </li>
              ))}
            </ul>
          </article>

          <article class="feature-card">
            <span class="card-kicker">Навигация</span>
            <h3>Связать patch обратно с системой</h3>
            <p>Карточки патчей должны связывать артефакты репозитория, страницы курса и логику плана.</p>
            <div class="actions">
              <a class="button-secondary" href={withBase("/ru/roadmap")}><Icon name="map" /> <span>Открыть план</span></a>
              <a class="button-secondary" href={withBase("/ru/resources")}><Icon name="notebook-pen" /> <span>Читать заметки</span></a>
            </div>
          </article>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
