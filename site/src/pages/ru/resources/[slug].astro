---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Icon from "../../../components/Icon.astro";
import { withBase } from "../../../lib/paths";

export async function getStaticPaths() {
  const notes = await getCollection("ru-notes");

  return notes.map((note) => ({
    params: { slug: note.slug },
    props: { note }
  }));
}

const { note } = Astro.props;
const { Content } = await render(note);
const otherNotes = (await getCollection("ru-notes"))
  .filter((entry) => entry.slug !== note.slug)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);
---

<BaseLayout
  title={`${note.data.title} | Modular Genesis`}
  description={note.data.summary}
  lang="ru"
  localeSwitch={{ href: `/resources/${note.slug}/`, label: "EN" }}
>
  <div class="page-stack">
    <section class="band band-hero">
      <div class="band-shell">
        <div class="display-grid">
          <div>
            <div class="eyebrow"><Icon name="notebook-pen" /> Опорная заметка</div>
            <h1 class="display-title" style="max-width: 8ch; font-size: clamp(3.1rem, 7vw, 5.4rem);">
              {note.data.title}
            </h1>
            <p class="lede">{note.data.summary}</p>
            <div class="actions">
              <a class="button" href={withBase("/ru/resources")}><Icon name="notebook-pen" /> <span>Назад к материалам</span></a>
              <a class="button-secondary" href={withBase("/ru/roadmap")}><Icon name="map" /> <span>Открыть план</span></a>
            </div>
          </div>

          <div class="hero-dashboard">
            <article class="feature-card">
              <span class="section-label"><Icon name="library-big" /> Роль заметки</span>
              <h3>Концептуальный слой для публичной системы</h3>
              <p>Такие заметки объясняют устойчивую логику за уроками, патчами и дальнейшим ростом сайта.</p>
              <ul class="feature-list">
                <li>контекст рабочего процесса и маршрутизации</li>
                <li>системная архитектура и направление проекта</li>
                <li>поддержка для будущих уроков и артефактов</li>
              </ul>
            </article>
          </div>
        </div>
      </div>
    </section>

    <section class="band band-subtle">
      <div class="band-shell">
        <article class="feature-card prose-panel">
          <Content />
        </article>
      </div>
    </section>

    <section class="band band-deep">
      <div class="band-shell">
        <div class="stack-grid">
          <article class="feature-card">
            <span class="card-kicker">Другие заметки</span>
            <h3>Связанные материалы</h3>
            <ul class="feature-list">
              {otherNotes.map((entry) => (
                <li>
                  <a class="related-link" href={withBase(`/ru/resources/${entry.slug}/`)}>
                    <Icon name="move-right" />
                    <span>{entry.data.title}</span>
                  </a>
                </li>
              ))}
            </ul>
          </article>

          <article class="feature-card">
            <span class="card-kicker">Навигация</span>
            <h3>Продолжить движение по системе</h3>
            <p>Справочные материалы должны возвращать тебя в roadmap, к урокам и в библиотеку патчей.</p>
            <div class="actions">
              <a class="button-secondary" href={withBase("/ru/course")}><Icon name="book-open" /> <span>Открыть курс</span></a>
              <a class="button-secondary" href={withBase("/ru/patches")}><Icon name="panels-top-left" /> <span>Открыть патчи</span></a>
            </div>
          </article>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
