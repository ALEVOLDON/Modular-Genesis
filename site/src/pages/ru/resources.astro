---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Icon from "../../components/Icon.astro";
import { getCollection } from "astro:content";
import { withBase } from "../../lib/paths";

const notes = (await getCollection("ru-notes")).sort((a, b) => a.data.order - b.data.order);
const featuredResources = notes.slice(0, 3);
const remainingResources = notes.slice(3);
---

<BaseLayout
  title="Материалы | Modular Genesis"
  description="Русскоязычный обзор опорных заметок проекта Modular Genesis."
  lang="ru"
  localeSwitch={{ href: "/resources", label: "EN" }}
>
  <div class="page-stack">
    <section class="band band-hero">
      <div class="band-shell">
        <div class="display-grid">
          <div>
            <div class="eyebrow"><Icon name="notebook-pen" /> Материалы</div>
            <h1 class="display-title">
              <span class="accent">Слой материалов</span> за уроками, патчами и диаграммами.
            </h1>
            <p class="lede">
              Эти заметки фиксируют устойчивые идеи проекта: hybrid workflow, generative structure,
              project vision и visual system planning, который расширяет модульную сторону проекта.
            </p>
            <div class="actions">
              <a class="button" href={withBase("/ru/roadmap")}><Icon name="map" /> <span>Открыть план</span></a>
              <a class="button-secondary" href={withBase("/ru/course")}><Icon name="book-open" /> <span>Смотреть уроки</span></a>
            </div>
          </div>

          <div class="hero-dashboard">
            <article class="feature-card">
              <span class="section-label"><Icon name="library-big" /> Охват заметок</span>
              <h3>Заметки объясняют систему, а не только отдельные техники.</h3>
              <ul class="metric-list">
                <li>
                  <strong>{notes.length}</strong>
                  опорных заметок уже опубликовано
                </li>
                <li>
                  <strong>Workflow</strong>
                  routing, sequencing roles, hybrid capture
                </li>
                <li>
                  <strong>Vision</strong>
                  repository structure, visual map, future lab direction
                </li>
              </ul>
            </article>
          </div>
        </div>
      </div>
    </section>

    <section class="band band-deep">
      <div class="band-shell">
        <div class="section-head">
          <div class="section-copy">
            <span class="section-label"><Icon name="notebook-pen" /> Основные заметки</span>
            <h2>Первый слой концентрируется на идеях, которые держат проект вместе.</h2>
            <p>Это заметки, которые сильнее всего связаны с текущими уроками, планом и логикой патчей.</p>
          </div>
        </div>

        <div class="stack-grid" style="margin-top: 10px;">
          {featuredResources.map((resource) => (
            <article class="feature-card">
              <span class="card-kicker">Материал</span>
              <h3>{resource.data.title}</h3>
              <p>{resource.data.summary}</p>
              <div class="actions">
                <a class="button-secondary" href={withBase(`/ru/resources/${resource.slug}/`)}><Icon name="move-right" /> <span>Открыть материал</span></a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="band band-alt">
      <div class="band-shell">
        <div class="split-hero">
          <article class="feature-card">
            <span class="section-label"><Icon name="workflow" /> Гибридный setup: справочник</span>
            <h2>Site-native diagram, извлеченная из исходного проектного мышления.</h2>
            <p>
              Эта схема заменяет старый slide material более чистым языком сайта, но сохраняет структурную идею:
              controller input, Ableton, VCV Rack, visuals и recording как единый setup.
            </p>
          </article>

          <div class="media-frame">
            <img src={withBase("/diagrams/hybrid-setup.svg")} alt="Диаграмма гибридного setup с controller, Ableton, VCV Rack, visuals и записью." />
          </div>
        </div>
      </div>
    </section>

    <section class="band band-subtle">
      <div class="band-shell">
        <div class="section-copy">
          <span class="section-label"><Icon name="files" /> Дополнительные заметки</span>
          <h2>Оставшиеся notes указывают на рост сайта и будущие слои системы.</h2>
          <p>Они менее операционные, чем workflow notes, но важны для того, куда проект идет дальше.</p>
        </div>

        <div class="cards-2" style="margin-top: 26px;">
          {remainingResources.map((resource) => (
            <article class="card">
              <span class="card-kicker">Материал</span>
              <h3>{resource.data.title}</h3>
              <p>{resource.data.summary}</p>
              <div class="actions">
                <a class="button-secondary" href={withBase(`/ru/resources/${resource.slug}/`)}><Icon name="move-right" /> <span>Открыть материал</span></a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
